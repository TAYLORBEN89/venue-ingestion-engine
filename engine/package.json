{
	"name": "events-platform-ingestion",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"check:hierarchy-schema": "node scripts/check-hierarchy-schema.mjs",
		"check:published-lock": "node --experimental-strip-types scripts/check-published-lock.mjs",
		"check:all": "npm run typecheck && npm run check:hierarchy-schema && npm run check:published-lock",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/webp": "^1.5.0",
		"@supabase/supabase-js": "^2.110.0"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"typescript": "^5.7.4",
		"wrangler": "^4.123.0"
	}
}
